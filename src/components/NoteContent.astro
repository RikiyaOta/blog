---
import * as nip19 from "nostr-tools/nip19";
import * as nip27 from "nostr-tools/nip27";
import { gatewayUrl, type Event } from "../lib/nostr";

interface Props {
  event: Event;
}

const { event } = Astro.props;
const blocks = [...nip27.parse(event)];

type Pointer = Extract<nip27.Block, { type: "reference" }>["pointer"];

// nostr: 参照は Web ゲートウェイ (njump.me) へのリンクにする
function encodePointer(pointer: Pointer): string {
  if ("identifier" in pointer) return nip19.naddrEncode(pointer);
  if ("id" in pointer) return nip19.neventEncode(pointer);
  return nip19.npubEncode(pointer.pubkey);
}

function shorten(code: string): string {
  return code.length > 24 ? `${code.slice(0, 16)}…${code.slice(-6)}` : code;
}
---
<div class="note-content">
  {blocks.map((block) => {
    switch (block.type) {
      case "text":
        return block.text;
      case "url":
        return <a href={block.url} rel="nofollow noopener">{block.url}</a>;
      case "image":
        return (
          <a href={block.url} rel="nofollow noopener">
            <img src={block.url} alt="" loading="lazy" />
          </a>
        );
      case "video":
        return <video src={block.url} controls preload="metadata" />;
      case "audio":
        return <audio src={block.url} controls preload="metadata" />;
      case "reference": {
        const code = encodePointer(block.pointer);
        return <a href={gatewayUrl(code)} class="nostr-ref">nostr:{shorten(code)}</a>;
      }
      case "emoji":
        return <img class="emoji" src={block.url} alt={`:${block.shortcode}:`} title={`:${block.shortcode}:`} />;
      case "hashtag":
        return `#${block.value}`;
      default:
        return block.url;
    }
  })}
</div>
