---
interface Props {
  date: Date | string | number | null | undefined;
}

const { date } = Astro.props;
if (!date) return null;

const d = date instanceof Date ? date : new Date(date);
const formatted = d.toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---
<time datetime={d.toISOString()}>{formatted}</time>
