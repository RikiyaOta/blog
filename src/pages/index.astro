---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProfile, gatewayUrl, npub } from "../lib/nostr";
import { site } from "../site.config";

const profile = await getProfile();

// リレーから取得できたときだけキャッシュする (取得失敗の結果を配り続けないため)
if (profile) {
  Astro.cache.set({ maxAge: 300, swr: 3600 });
}
---
<BaseLayout profile={profile}>
  <section>
    <h2>About</h2>
    {profile?.about ? (
      <p class="pre-wrap">{profile.about}</p>
    ) : (
      <p class="muted">プロフィールを取得できませんでした。</p>
    )}
  </section>

  <section>
    <h2>Links</h2>
    <dl class="links">
      <dt>Nostr</dt>
      <dd><a href={gatewayUrl(npub)} class="mono" rel="me">{npub}</a></dd>
      {site.links.map((link) => (
        <>
          <dt>{link.label}</dt>
          <dd><a href={link.url} rel="me">{link.url}</a></dd>
        </>
      ))}
    </dl>
  </section>
</BaseLayout>
