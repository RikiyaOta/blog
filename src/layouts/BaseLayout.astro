---
import { site } from "../site.config";
import type { Profile } from "../lib/nostr";
import "../styles/global.css";

interface Props {
  title?: string;
  profile?: Profile | null;
}

const { title, profile } = Astro.props;
const pageTitle = title ? `${title} - ${site.name}` : site.name;
const description = profile?.about?.split("\n")[0] || site.name;
const path = Astro.url.pathname;

const tabs = [
  { href: "/", label: "About" },
  { href: "/posts", label: "Posts" },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {profile?.picture && <link rel="icon" href={profile.picture} />}
  </head>
  <body>
    <nav class="tabs">
      {tabs.map((tab) => (
        <a href={tab.href} aria-current={path === tab.href ? "page" : undefined}>{tab.label}</a>
      ))}
    </nav>
    <header class="site-header">
      {profile?.picture && <img class="avatar" src={profile.picture} alt="" width="56" height="56" />}
      <a href="/" class="site-name">{site.name}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {site.name}</p>
    </footer>
  </body>
</html>
