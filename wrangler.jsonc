{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "rikiyaota.kyoto", "custom_domain": true },
    // 旧ブログのドメイン。Worker 内で新ドメインへリダイレクトする
    { "pattern": "blog.rikiyaota.kyoto", "custom_domain": true }
  ]
}
